{
  "name": "chatgpt-ads-library",
  "version": "1.0.0",
  "private": true,
  "description": "A searchable library of ads running on ChatGPT, built on Cloudflare Pages, D1, and R2 with React Router v7 SSR.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:worker\" \"npm run dev:site\"",
    "dev:worker": "wrangler dev -c worker/wrangler.toml --port 8787",
    "dev:site": "npx -y serve site -l 3000",
    "dev:pages": "wrangler pages dev site --binding API_BASE_URL=http://127.0.0.1:8787",
    "deploy": "npm run deploy:worker && npm run deploy:site",
    "deploy:worker": "wrangler deploy -c worker/wrangler.toml",
    "deploy:site": "wrangler pages deploy site --project-name=chatgpt-ads-library",
    "seed:local": "wrangler d1 execute chatgpt-ads-library --local --file=./frontend/seed.sql --config=worker/wrangler.toml",
    "seed:remote": "wrangler d1 execute chatgpt-ads-library --remote --file=./frontend/seed.sql --config=worker/wrangler.toml",
    "seed:generate": "node scripts/generate-seed.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "wrangler": "^3.91.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
